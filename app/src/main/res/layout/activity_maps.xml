<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mapsMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5FDFF">

    <!-- Title -->
    <TextView
        android:id="@+id/mapsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Locate Your Nearest Branch"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#000"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Static Google Maps-style image or icon -->
    <ImageView
        android:id="@+id/mapsImage"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:src="@drawable/ic_action_map"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/mapsTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="Map Preview" />

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/imageButtonLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        android:gravity="center">

        <ImageButton
            android:id="@+id/accountsImageButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/ic_action_accounts"
            android:background="#00000000"
            android:contentDescription="Accounts" />

        <ImageButton
            android:id="@+id/settingsImageButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/ic_action_settings"
            android:background="#00000000"
            android:contentDescription="Settings" />

        <ImageButton
            android:id="@+id/mapsImageButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/ic_action_map"
            android:background="#00000000"
            android:contentDescription="Maps" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
