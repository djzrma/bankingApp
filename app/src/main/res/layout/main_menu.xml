<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainMenu">

    <!-- Accounts Title -->
    <TextView
        android:id="@+id/accountsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your Accounts"
        android:textStyle="bold"
        android:textSize="22sp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Checkings Section -->
    <TextView
        android:id="@+id/checkingsLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Checkings Balance: $4,512.33"
        android:textSize="18sp"
        android:background="#FFF3E0"
        android:padding="12dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/accountsTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp" />

    <!-- Savings Section -->
    <TextView
        android:id="@+id/savingsLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Savings Balance: $9,875.20"
        android:textSize="18sp"
        android:background="#E0F7FA"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/checkingsLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp" />

    <!-- Credit Lines Banner -->
    <TextView
        android:id="@+id/creditLinesBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CREDIT LINES"
        android:textStyle="bold"
        android:textSize="20sp"
        android:background="#D1C4E9"
        android:padding="8dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/savingsLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Credit Card Section -->
    <TextView
        android:id="@+id/creditCardLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Credit Card Balance: $1,245.67"
        android:textSize="18sp"
        android:background="#FCE4EC"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/creditLinesBanner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp" />

    <!-- Car Loan Section -->
    <TextView
        android:id="@+id/carLoanLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Car Loan Balance: $8,200.00"
        android:textSize="18sp"
        android:background="#E8F5E9"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/creditCardLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp" />

    <!-- Bottom Navigation Buttons -->
    <LinearLayout
        android:id="@+id/imageButtonLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/homeImageButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:srcCompat="@drawable/ic_action_home"
            android:contentDescription="Home" />

        <ImageButton
            android:id="@+id/accountsImageButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:srcCompat="@drawable/ic_action_accounts"
            android:contentDescription="Accounts" />

        <ImageButton
            android:id="@+id/transferImageButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:srcCompat="@drawable/ic_action_transfer"
            android:contentDescription="Transfer" />

        <ImageButton
            android:id="@+id/settingsImageButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:srcCompat="@drawable/ic_action_settings"
            android:contentDescription="Settings" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
